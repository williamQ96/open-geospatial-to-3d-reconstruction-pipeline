{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Independent WGS84 road/path centerlines",
  "type": "object",
  "required": ["type", "features", "sources"],
  "properties": {
    "type": {"const": "FeatureCollection"},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "url", "sha256", "license_url"], "properties": {"id": {"type": "string"}, "url": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "license_url": {"type": "string"}}}},
    "features": {
      "type": "array",
      "items": {
        "type": "object", "required": ["type", "id", "geometry", "properties"],
        "properties": {
          "type": {"const": "Feature"}, "id": {"type": "string", "minLength": 1},
          "geometry": {"type": "object", "required": ["type", "coordinates"], "properties": {"type": {"const": "LineString"}, "coordinates": {"type": "array", "minItems": 2, "items": {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{"type": "number", "minimum": -180, "maximum": 180}, {"type": "number", "minimum": -90, "maximum": 90}]}}}},
          "properties": {"type": "object", "required": ["name", "kind", "width_m", "source_id"], "properties": {"name": {"type": "string"}, "kind": {"enum": ["road", "path"]}, "width_m": {"type": "number", "exclusiveMinimum": 0, "maximum": 60}, "source_id": {"type": "string"}}}
        }
      }
    }
  }
}
